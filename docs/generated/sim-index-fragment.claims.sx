  (primary [row Route(RouteRecord { id: RouteId("route/build-expression-tree"), title: "Build an expression tree", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-expr-tree/expression-tree"), why: "The loadable framework exposes the stable capability-gated operation family, Shapes, Cards, durable Citizens, and ordinary Expr/Value behavior." }, Feature { id: FeatureId("feature/sim-expr-tree/mixed-backend-storage"), why: "The storage feature composes authored source, operational control, rebuildable derived state, and explicit Table/Dir mounts." }, Feature { id: FeatureId("feature/sim-expr-tree/incremental-calculation"), why: "The calculation feature supplies bounded automatic and directed dependency-aware work, receipts, refresh, and standard streams." }, Feature { id: FeatureId("feature/sim-expr-tree/codec-policy"), why: "The codec policy feature applies installed general-purpose codecs with inherited read and output bounds instead of creating a tree-specific codec." }, Specimen { id: SpecimenId("recipe/sim-expr-tree/crates/sim-lib-expr-tree/01-basics/finite-tree"), why: "The checked Lisp recipe creates generated names, mixes backend kinds, and resolves bare, relative, and absolute paths." }, Specimen { id: SpecimenId("recipe/sim-expr-tree/crates/sim-lib-expr-tree/02-calculation/automatic-and-directed"), why: "The checked Lisp recipe combines automatic and manual work, inspects receipt evidence, repairs a cycle, and reopens named storage." }], doc_anchor: None })] [note "route/build-expression-tree"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/edit-expedition-book"), title: "Edit and replay an expedition decision book", audiences: [], steps: [Feature { id: FeatureId("feature/sim-expr-tree/expression-tree"), why: "The existing framework supplies the durable expression-tree organ rather than a new graph engine." }, Feature { id: FeatureId("feature/sim-expr-tree/expedition-book"), why: "The book adds optimistic semantic edits, canonical export, disposable projections, and exact external evidence references." }], doc_anchor: None })] [note "route/edit-expedition-book"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/expose-expression-tree-view"), title: "Expose an expression tree view", audiences: ["code", "framework"], steps: [Feature { id: FeatureId("feature/sim-expr-tree/expression-tree-view"), why: "The expression-tree view row owns the bounded reversible outline over standard Scene, Intent, SurfaceCodec, and SurfaceCaps contracts." }, Specimen { id: SpecimenId("spec-test/sim-expr-tree/crates/sim-lib-view-expr-tree/src/tests"), why: "The focused conformance module proves full rendering, intent reversal, lazy disclosure, continuation, freshness, hostile values, stale revisions, accessibility, large trees, layout projection, and authorization." }], doc_anchor: None })] [note "route/expose-expression-tree-view"] [section "route"])
  (primary [row Route(RouteRecord { id: RouteId("route/find-expression-tree-command"), title: "Find code behind the expression tree command", audiences: ["user", "code", "framework"], steps: [Feature { id: FeatureId("feature/sim-expr-tree/expression-tree-product"), why: "The product row identifies the thin bootloader binary, loadable serve entrypoint, standard runtime configuration, and component recipe behind the command." }, Specimen { id: SpecimenId("spec-test/sim-expr-tree/crates/sim-lib-expr-tree-serve/src/tests"), why: "The serve specimen proves capabilities, in-process and external EvalFabric placement, configured storage, web-surface injection, and graceful shutdown." }], doc_anchor: None })] [note "route/find-expression-tree-command"] [section "route"])
